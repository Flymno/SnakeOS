/* ---------------- Includes ---------------- */
#include <common/types.h>

/* ---------------- Internal Constants ---------------- */
#define PAGE_PRESENT (1ULL << 0)
#define PAGE_WRITABLE (1ULL << 1)
#define PAGE_HUGE (1ULL << 7)

typedef struct {
	u32 base;
	u32 limit;
	u8 access;
	u8 flags;
} GDTEntry_t;

typedef struct {
	u16 limit;
	u32 base;
}__attribute__((packed)) GDTPointer_t;

/* ---------------- Internal State ---------------- */
__attribute__((section(".bootstrap.bss"), aligned(4096))) u64 earlyPML4[512];
__attribute__((section(".bootstrap.bss"), aligned(4096))) u64 earlyPDPLow[512];
__attribute__((section(".bootstrap.bss"), aligned(4096))) u64 earlyPDPHigh[512];
__attribute__((section(".bootstrap.bss"), aligned(4096))) u64 earlyPDShared[512];

__attribute__((section(".bootstrap.bss"))) GDTEntry_t gdtTable[3];
__attribute__((section(".bootstrap.bss"), aligned(8))) u8 gdtData[3 * 8];
__attribute__((section(".bootstrap.bss"))) GDTPointer_t gdtp;

/* ---------------- Public API Implementation ---------------- 
* uint32_t* init_early_paging()
*   -Sets up the initial corase page directories to jump to a high-half kernel
*/
__attribute__((section(".bootstrap.text")))
u32 init_early_paging() {
    for (size_t i = 0; i < 512; i++) {
        earlyPML4[i] = earlyPDPLow[i] = earlyPDPHigh[i] = earlyPDShared[i] = 0;
    }

    for (size_t i = 0; i < 4; i++) {
        earlyPDShared[511 - i] = (i * 0x200000) | PAGE_HUGE | PAGE_PRESENT | PAGE_WRITABLE;
        earlyPDShared[i] = (i * 0x200000) | PAGE_HUGE | PAGE_PRESENT | PAGE_WRITABLE;
    }

    earlyPML4[0] = (u32)earlyPDPLow | PAGE_PRESENT | PAGE_WRITABLE;
    earlyPML4[511] = (u32)earlyPDPHigh | PAGE_PRESENT | PAGE_WRITABLE;

    earlyPDPLow[0] = (u32)earlyPDShared | PAGE_PRESENT | PAGE_WRITABLE;
    earlyPDPHigh[511] = (u32)earlyPDShared | PAGE_PRESENT | PAGE_WRITABLE;

    return (u32)earlyPML4;
}

__attribute__((section(".bootstrap.text")))
u32 init_early_gdt() {
    // Null Segment
	gdtTable[0].base = 0; 
    gdtTable[0].limit = 0; 
    gdtTable[0].access = 0; 
    gdtTable[0].flags = 0;

    // Kernel Code Segment
    gdtTable[1].base = 0; 
    gdtTable[1].limit = 0xFFFFF; 
    gdtTable[1].access = 0x9A; 
    gdtTable[1].flags = 0x0A;

    // Kernel Data Segment
    gdtTable[2].base = 0; 
    gdtTable[2].limit = 0xFFFFF; 
    gdtTable[2].access = 0x92; 
    gdtTable[2].flags = 0x0C;

    for (size_t i = 0; i < 3; i++) {
        u8* entry = &gdtData[i * 8];
        
        // Encode the limit
        entry[0] = gdtTable[i].limit & 0xFF;
        entry[1] = (gdtTable[i].limit >> 8) & 0xFF;
        entry[6] = (gdtTable[i].limit >> 16) & 0x0F;
    
        // Encode the base
        entry[2] = gdtTable[i].base & 0xFF;
        entry[3] = (gdtTable[i].base >> 8) & 0xFF;
        entry[4] = (gdtTable[i].base >> 16) & 0xFF;
        entry[7] = (gdtTable[i].base >> 24) & 0xFF;
    
        // Encode the access byte
        entry[5] = gdtTable[i].access;
    
        // Encode the flags
        entry[6] |= (gdtTable[i].flags << 4);
    }

    gdtp.limit = (3 * 8) - 1;
	gdtp.base = (u32)gdtData;

    return (u32)&gdtp;
}